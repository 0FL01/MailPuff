# --- IMAP settings ---
MAIL_SOURCE=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=""
IMAP_TLS=true
IMAP_ACCEPT_INVALID_CERTS=false
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL=60s
IMAP_FORCE_RECONNECT=60s
IMAP_MARK_SEEN=false

# --- Telegram ---
TELEGRAM_TOKEN=12
TELEGRAM_CHAT_ID=1

# HTTP и Viewer
HTTP_ADDR=:8080
VIEWER_URL_BASE=http://127.0.0.1:8080/view
VIEWER_PAGE_TTL=48h
VIEWER_PAGE_MAX_VIEWS=3
VIEWER_REMOTE_IMAGES=allow

# --- Logging ---
RUST_LOG=info

# Optional: timezone for the container
TZ=Europe/Moscow
